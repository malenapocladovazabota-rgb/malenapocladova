# Cloudflare Pages headers
# Безопасность + кэширование статики

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  # payment разрешён себе и фреймам Stripe. Пустое payment=() глушит Payment
  # Request API, а вместе с ним кнопки Apple Pay и Google Pay во встроенном
  # чекауте. При мобильном трафике это прямая потеря оплат.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(self "https://checkout.stripe.com" "https://js.stripe.com")

# Картинки кэшируем агрессивно (год, immutable)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Шрифты от Google CDN кэшируются на их стороне, но HTML — короткий кэш
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Версия для правок закрыта от индексации, боевая страница открыта
/prodvizhenie-review*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
